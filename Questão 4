#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Defini esses tamanhos gigantes porque o dataset do Galli tem mais de 100k linhas.
// Se colocar valores pequenos aqui, o programa crasha na hora de ler.
#define MAX_MULHERES 200000
#define MAX_RANKING 20000
#define TAM_LINHA 4096

typedef struct { 
    int id_referencia; 
} AtletaFeminina;

typedef struct { 
    char nome_completo[150]; 
    int contador_medalhas; 
} RegistroMedalhista;

// Variáveis globais para não estourar a memória do computador do lab
AtletaFeminina cadastro_mulheres[MAX_MULHERES];
int total_mulheres_mapeadas = 0;
RegistroMedalhista podio_geral[MAX_RANKING];
int total_atletas_no_podio = 0;

// Função pra ordenar o ranking. O qsort usa isso pra colocar quem tem mais medalha no topo.
int ordenar_por_medalha(const void *a, const void *b) {
    RegistroMedalhista *atletaA = (RegistroMedalhista *)a;
    RegistroMedalhista *atletaB = (RegistroMedalhista *)b;
    return atletaB->contador_medalhas - atletaA->contador_medalhas;
}

void carregar_arquivo_bios() {
    FILE *ponteiro_bios = fopen("bios.csv", "r");
    if (!ponteiro_bios) {
        printf("Deu ruim: arquivo bios.csv nao encontrado!\n");
        return;
    }
    
    char buffer_leitura[TAM_LINHA];
    // ESSENCIAL: Pula a primeira linha (cabeçalho), senão ele tenta ler o nome da coluna como ID
    fgets(buffer_leitura, TAM_LINHA, ponteiro_bios); 
    
    while (fgets(buffer_leitura, TAM_LINHA, ponteiro_bios)) {
        char *p_aux = buffer_leitura;
        int cont_col = 0, aspas_abertas = 0;
        char *campos[20];
        
        // Gambiarra necessária pra ignorar vírgula dentro de aspas (o CSV do Galli é cheio disso)
        campos[cont_col++] = p_aux;
        for (; *p_aux; p_aux++) {
            if (*p_aux == '"') aspas_abertas = !aspas_abertas;
            else if (*p_aux == ',' && !aspas_abertas) {
                *p_aux = '\0';
                campos[cont_col++] = p_aux + 1;
            }
        }
        // Se a coluna 1 for 'Female', guarda o ID que tá na coluna 7
        if (cont_col >= 8 && strstr(campos[1], "Female")) {
            cadastro_mulheres[total_mulheres_mapeadas++].id_referencia = atoi(campos[7]);
        }
    }
    fclose(ponteiro_bios);
}

void processar_arquivo_results() {
    FILE *ponteiro_results = fopen("results.csv", "r");
    if (!ponteiro_results) return;
    
    char buffer_leitura[TAM_LINHA];
    // Pula o cabeçalho do results.csv tbm
    fgets(buffer_leitura, TAM_LINHA, ponteiro_results);

    while (fgets(buffer_leitura, TAM_LINHA, ponteiro_results)) {
        char *campos_res[20];
        int c_idx = 0, aspas_abertas = 0;
        char *p_aux = buffer_leitura;

        // Mesmo parser manual pra não quebrar nos nomes das provas que tem vírgula
        campos_res[c_idx++] = p_aux;
        for (; *p_aux; p_aux++) {
            if (*p_aux == '"') aspas_abertas = !aspas_abertas;
            else if (*p_aux == ',' && !aspas_abertas) {
                *p_aux = '\0';
                campos_res[c_idx++] = p_aux + 1;
            }
        }

        if (c_idx >= 7) {
            int ano_evento = atoi(campos_res[0]);
            
            /* FILTROS IMPORTANTES:
               1. strlen > 1: Tira campos vazios que bugam o contador.
               2. strcmp != "na": O 'na' significa que o atleta não ganhou nada, então a gente ignora.
            */
            if (ano_evento >= 2004 && strlen(campos_res[4]) > 1 && strcmp(campos_res[4], "na") != 0) {
                int id_atual = atoi(campos_res[6]);
                
                // Só entra no ranking se o ID estiver na lista de mulheres que carregamos antes
                int is_fem = 0;
                for(int i=0; i < total_mulheres_mapeadas; i++) {
                    if(cadastro_mulheres[i].id_referencia == id_atual) { is_fem = 1; break; }
                }

                if (is_fem) {
                    int ja_existe = 0;
                    for (int i = 0; i < total_atletas_no_podio; i++) {
                        if (strcmp(podio_geral[i].nome_completo, campos_res[5]) == 0) {
                            podio_geral[i].contador_medalhas++;
                            ja_existe = 1; break;
                        }
                    }
                    if (!ja_existe && total_atletas_no_podio < MAX_RANKING) {
                        strcpy(podio_geral[total_atletas_no_podio].nome_completo, campos_res[5]);
                        podio_geral[total_atletas_no_podio].contador_medalhas = 1;
                        total_atletas_no_podio++;
                    }
                }
            }
        }
    }
    fclose(ponteiro_results);
}

int main() {
    carregar_arquivo_bios();
    processar_arquivo_results();
    
    // Organiza a bagunça: do maior número de medalhas pro menor
    qsort(podio_geral, total_atletas_no_podio, sizeof(RegistroMedalhista), ordenar_por_medalha);

    int top_dez = (total_atletas_no_podio < 10) ? total_atletas_no_podio : 10;
    
    // Arquivo auxiliar pro Gnuplot ler
    FILE *arquivo_temporario = fopen("grafico.dat", "w");
    for (int i = 0; i < top_dez; i++) {
        fprintf(arquivo_temporario, "\"%s\" %d\n", podio_geral[i].nome_completo, podio_geral[i].contador_medalhas);
    }
    fclose(arquivo_temporario);

    // Configuração do Gnuplot
    FILE *janela_grafico = popen("gnuplot -persist", "w");
    if (janela_grafico) {
        fprintf(janela_grafico, "set title 'Top 10 Atletas Femininas com mais Medalhas (desde 2004)' font ',12'\n");
        fprintf(janela_grafico, "set style fill solid 0.8 border -1\n");
        fprintf(janela_grafico, "set ylabel 'Total de Medalhas'\n");
        fprintf(janela_grafico, "set grid y\n");
        fprintf(janela_grafico, "set bmargin 12\n"); // Margem grande pros nomes não sumirem
        
        // RESOLVE O BUG DAS BARRAS VAZIAS: 
        // Força o eixo Y a começar no 0 e a mostrar todas as categorias do arquivo .dat
        fprintf(janela_grafico, "set yrange [0:*]\n"); 
        
        fprintf(janela_grafico, "set xtics rotate by -45 font ',8'\n"); // Inclina os nomes pra nao virar um borrão
        fprintf(janela_grafico, "plot 'grafico.dat' using 2:xtic(1) with boxes notitle lc rgb 'dark-violet'\n");
        pclose(janela_grafico);
    }

    // Print no terminal só pra garantir a conferência
    printf("\n--- RESULTADO FINAL ---\n");
    for (int i = 0; i < top_dez; i++) {
        printf("%d. %s [%d medalhas]\n", i+1, podio_geral[i].nome_completo, podio_geral[i].contador_medalhas);
    }

    return 0;
}
